      "source": [
        "# ------------------------------------------------------------------------------\n",
        "# GENERATE LATEX TABLE (MEANS & STANDARD DEVIATIONS)\n",
        "# ------------------------------------------------------------------------------\n",
        "print(\"\\n--- GENERATING LATEX TABLE 1 ---\")\n",
        "cols_to_summarize = ['Price_USD', 'Sodium_mg', 'SatFat_g', 'TotalSugar_g', 'Calories_kcal']\n",
        "\n",
        "# Calculate Means and SDs\n",
        "summary_means = df_final.groupby('Category')[cols_to_summarize].mean()\n",
        "summary_sds = df_final.groupby('Category')[cols_to_summarize].std()\n",
        "summary_counts = df_final.groupby('Category').size().rename('N')\n",
        "\n",
        "# Calculate Overall Means and SDs\n",
        "overall_means = df_final[cols_to_summarize].mean()\n",
        "overall_sds = df_final[cols_to_summarize].std()\n",
        "overall_N = len(df_final)\n",
        "\n",
        "latex_t1 = \"\\\\begin{table}[h!]\\n\\\\centering\\n\"\n",
        "latex_t1 += \"\\\\caption{Summary Statistics of the Keyword-Mapped USDA Convenience Catalog (Mean $\\\\pm$ SD per 250g serving)}\\n\"\n",
        "latex_t1 += \"\\\\label{tab:summary_stats}\\n\"\n",
        "latex_t1 += \"\\\\begin{adjustbox}{max width=\\\\textwidth}\\n\"\n",
        "latex_t1 += \"\\\\begin{tabular}{lrrrrrr}\\n\\\\toprule\\n\"\n",
        "latex_t1 += \" & $N$ & Price (\\\\$) & Sodium (mg) & Saturated Fat (g)}& Total Sugar (g) & Calories (kcal) \\\\\\\\\\n\\\\midrule\\n\"\n",
        "\n",
        "# Loop through categories\n",
        "for idx in summary_means.index:\n",
        "    n_val = int(summary_counts[idx])\n",
        "    p_str = f\"{summary_means.loc[idx, 'Price_USD']:.2f} ($\\\\pm${summary_sds.loc[idx, 'Price_USD']:.2f})\"\n",
        "    s_str = f\"{summary_means.loc[idx, 'Sodium_mg']:.1f} ($\\\\pm${summary_sds.loc[idx, 'Sodium_mg']:.1f})\"\n",
        "    f_str = f\"{summary_means.loc[idx, 'SatFat_g']:.1f} ($\\\\pm${summary_sds.loc[idx, 'SatFat_g']:.1f})\"\n",
        "    su_str = f\"{summary_means.loc[idx, 'TotalSugar_g']:.1f} ($\\\\pm${summary_sds.loc[idx, 'TotalSugar_g']:.1f})\"\n",
        "    c_str = f\"{summary_means.loc[idx, 'Calories_kcal']:.1f} ($\\\\pm${summary_sds.loc[idx, 'Calories_kcal']:.1f})\"\n",
        "\n",
        "    latex_t1 += f\"{idx} & {n_val} & {p_str} & {s_str} & {f_str} & {su_str} & {c_str} \\\\\\\\\\n\"\n",
        "\n",
        "latex_t1 += \"\\\\midrule\\n\"\n",
        "\n",
        "# Add overall row\n",
        "p_str_all = f\"{overall_means['Price_USD']:.2f} ($\\\\pm${overall_sds['Price_USD']:.2f})\"\n",
        "s_str_all = f\"{overall_means['Sodium_mg']:.1f} ($\\\\pm${overall_sds['Sodium_mg']:.1f})\"\n",
        "f_str_all = f\"{overall_means['SatFat_g']:.1f} ($\\\\pm${overall_sds['SatFat_g']:.1f})\"\n",
        "su_str_all = f\"{overall_means['TotalSugar_g']:.1f} ($\\\\pm${overall_sds['TotalSugar_g']:.1f})\"\n",
        "c_str_all = f\"{overall_means['Calories_kcal']:.1f} ($\\\\pm${overall_sds['Calories_kcal']:.1f})\"\n",
        "\n",
        "latex_t1 += f\"Overall Average & {overall_N} & {p_str_all} & {s_str_all} & {f_str_all} & {su_str_all} & {c_str_all} \\\\\\\\\\n\"\n",
        "\n",
        "latex_t1 += \"\\\\bottomrule\\n\\\\end{tabular}\\n\\\\end{adjustbox}\\n\\\\end{table}\"\n",
        "\n",
        "print(latex_t1)"
