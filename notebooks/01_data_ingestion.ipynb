    {
      "cell_type": "code",
      "source": [
        "# ==============================================================================\n",
        "# SCRIPT 01: DATA INGESTION, DETERMINISTIC CLASSIFICATION, & BASELINE\n",
        "# ==============================================================================\n",
        "!pip install -q odfpy\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import requests\n",
        "import scipy.stats as stats\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "def download_dropbox_file(url, filename):\n",
        "    print(f\"Downloading {filename}...\")\n",
        "    r = requests.get(url, allow_redirects=True)\n",
        "    with open(filename, 'wb') as f:\n",
        "        f.write(r.content)\n",
        "\n",
        "# 1. DOWNLOAD AND MERGE\n",
        "foods_url = \" "\n",
        "nutrients_url = \""\n",
        "prices_url = \""\n",
        "\n",
        "download_dropbox_file(foods_url, \"fndds_foods.ods\")\n",
        "download_dropbox_file(nutrients_url, \"fndds_nutrients.ods\")\n",
        "download_dropbox_file(prices_url, \"ppnap_prices.csv\")\n",
        "\n",
        "df_foods = pd.read_excel(\"fndds_foods.ods\", engine=\"odf\", header=1)\n",
        "df_nutr = pd.read_excel(\"fndds_nutrients.ods\", engine=\"odf\", header=1)\n",
        "df_prices = pd.read_csv(\"ppnap_prices.csv\", encoding=\"cp1252\")\n",
        "\n",
        "for df in [df_foods, df_nutr, df_prices]:\n",
        "    df.columns = df.columns.str.lower().str.strip()\n",
        "if 'food code' in df_nutr.columns:\n",
        "    df_nutr.rename(columns={'food code': 'food_code'}, inplace=True)\n",
        "\n",
        "df_empirical = pd.merge(df_nutr, df_prices, on='food_code', how='inner')\n",
        "\n",
        "col_cal = [c for c in df_empirical.columns if 'kcal' in c or 'energy' in c][0]\n",
        "col_sod = next((c for c in df_empirical.columns if 'sodium' in c.lower()), None)\n",
        "col_sat = next((c for c in df_empirical.columns if 'saturated' in c.lower() or 'sat fat' in c.lower()), None)\n",
        "col_sug = next((c for c in df_empirical.columns if 'sug' in c.lower()), None)\n",
        "col_desc = next((c for c in df_empirical.columns if 'description' in c.lower() and 'main' in c.lower()), None)\n",
        "\n",
        "df_empirical['search_name'] = df_empirical[col_desc].astype(str).str.lower()\n",
        "mask_noodles = df_empirical['search_name'].str.contains('noodle|ramen|soup, dry|soup, canned', na=False)\n",
        "mask_mac = df_empirical['search_name'].str.contains('macaroni|pasta', na=False)\n",
        "mask_meals = df_empirical['search_name'].str.contains('frozen|tv dinner|burrito|pizza', na=False)\n",
        "df_catalog = df_empirical[mask_noodles | mask_mac | mask_meals].copy()\n",
        "\n",
        "serving_multiplier = 2.5\n",
        "df_catalog['Price_USD'] = pd.to_numeric(df_catalog['price_100gm'], errors='coerce') * serving_multiplier\n",
        "df_catalog['Calories_kcal'] = pd.to_numeric(df_catalog[col_cal], errors='coerce') * serving_multiplier\n",
        "df_catalog['Sodium_mg'] = pd.to_numeric(df_catalog[col_sod], errors='coerce') * serving_multiplier\n",
        "df_catalog['SatFat_g'] = pd.to_numeric(df_catalog[col_sat], errors='coerce') * serving_multiplier\n",
        "df_catalog['TotalSugar_g'] = pd.to_numeric(df_catalog[col_sug], errors='coerce') * serving_multiplier\n",
        "\n",
        "# 2. CLASSIFICATION\n",
        "def assign_category_and_time(name):\n",
        "    name_lower = str(name).lower()\n",
        "    if any(kw in name_lower for kw in ['ramen', 'noodle', 'soup']):\n",
        "        return pd.Series([\"Instant Noodles and Soups\", 3.0])\n",
        "    elif any(kw in name_lower for kw in ['macaroni', 'mac &', 'pasta']):\n",
        "        return pd.Series([\"Macaroni and Pasta\", 10.0])\n",
        "    elif any(kw in name_lower for kw in ['frozen', 'tv dinner', 'pizza', 'burrito']):\n",
        "        return pd.Series([\"Frozen and Ready Meals\", 5.0])\n",
        "    else:\n",
        "        return pd.Series([None, None])\n",
        "\n",
        "df_catalog[['Category', 'Prep_Time_min']] = df_catalog[col_desc].apply(assign_category_and_time)\n",
        "\n",
        "# 3. FINALIZE\n",
        "df_final = df_catalog[['food_code', col_desc, 'Price_USD', 'Prep_Time_min', 'Calories_kcal', 'Sodium_mg', 'SatFat_g', 'TotalSugar_g', 'Category']].copy()\n",
        "df_final.rename(columns={col_desc: 'Product_Name'}, inplace=True)\n",
        "df_final = df_final.dropna(subset=['Category', 'Price_USD', 'Sodium_mg', 'SatFat_g', 'TotalSugar_g'])\n",
        "df_final = df_final.groupby(['food_code', 'Product_Name', 'Prep_Time_min', 'Calories_kcal', 'Sodium_mg', 'SatFat_g', 'TotalSugar_g', 'Category'])['Price_USD'].median().reset_index()\n",
        "df_final = df_final.sort_values(by='Price_USD').reset_index(drop=True)\n",
        "\n",
        "df_final.to_csv('usda_empirical_catalog.csv', index=False)"
      ],
